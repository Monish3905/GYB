{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@blockchain-sdk/*": ["packages/blockchain-sdk/src/*"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "**/*.test.ts", "dist"]
}
